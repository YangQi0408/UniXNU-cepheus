# Keep scripts and CI files LF so they run correctly on the Linux/macOS runners.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.patch text eol=lf
# Unified diff context prefixes legitimately precede tabs or empty lines.
# Applied source whitespace is still checked by git apply.
*.patch whitespace=-blank-at-eol,-space-before-tab
